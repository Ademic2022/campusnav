# Copy this file to `.env` in the project root and fill in your values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real tokens.

# Mapbox public access token (pk.…), from https://account.mapbox.com/access-tokens/
# Used by Dart, iOS and Android (Android reads it via android/app/build.gradle.kts).
MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_public_token_here
